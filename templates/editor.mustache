{{!
    @template local_quizbulkedit/editor

    Table of quizzes with editable settings plus a bulk-fill toolbar.

    Example context (json):
    {
        "actionurl": "https://example.com/local/quizbulkedit/index.php",
        "courseid": 2,
        "sesskey": "abc",
        "hasrows": true,
        "colspan": 4,
        "defaultcolumns": "visible,password",
        "groups": [{"label": "General", "columns": [{"field": "visible", "label": "Visibility", "checked": true}]}],
        "filter": "",
        "reviewgrid": "{}",
        "fields": [
            {"field": "password", "label": "Password", "hint": null, "isselect": false, "type": "text", "value": ""},
            {"field": "visible", "label": "Visibility", "hint": null, "isselect": true,
             "options": [{"value": "1", "label": "Shown", "selected": true}]}
        ],
        "rows": [{
            "quizid": 5, "name": "Quiz 1", "url": "#", "editurl": "#", "section": "Topic 1", "hidden": false,
            "cells": [
                {"field": "password", "isselect": false, "type": "text", "value": "abc", "original": "abc",
                 "changed": false, "error": null, "label": "Password: Quiz 1", "isnumber": false, "step": "1"},
                {"field": "visible", "isselect": true, "original": "1", "changed": false, "error": null,
                 "label": "Visibility: Quiz 1", "disabled": false,
                 "options": [{"value": "1", "label": "Shown", "selected": true}]}
            ],
            "reviewopen": false,
            "unusedduring": "reviewcorrectness"
        }]
    }
}}
{{^hasrows}}
    {{#str}} noquizzes, local_quizbulkedit {{/str}}
{{/hasrows}}
{{#hasrows}}
<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <label for="local_quizbulkedit_filter" class="form-label mb-0">{{#str}} filter, local_quizbulkedit {{/str}}</label>
    <input type="search" id="local_quizbulkedit_filter" class="form-control w-auto" value="{{filter}}"
           data-action="filter" placeholder="{{#str}} filterplaceholder, local_quizbulkedit {{/str}}">
    <span class="text-muted small" data-region="filtercount" aria-live="polite"></span>
    <div class="form-check form-switch mb-0 ms-2">
        <input type="checkbox" class="form-check-input" id="local_quizbulkedit_changedonly" data-action="changedonly">
        <label for="local_quizbulkedit_changedonly" class="form-check-label">{{#str}} changedonly, local_quizbulkedit {{/str}}</label>
    </div>
    <div class="dropdown ms-auto">
        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown"
                data-bs-auto-close="outside" aria-expanded="false" id="local_quizbulkedit_columnsbtn">
            {{#str}} columns, local_quizbulkedit {{/str}}
        </button>
        <div class="dropdown-menu dropdown-menu-end p-3 local-quizbulkedit-columns" aria-labelledby="local_quizbulkedit_columnsbtn"
             data-region="columns" data-default="{{defaultcolumns}}">
            {{#groups}}
            <fieldset class="mb-2">
                <legend class="fs-6 fw-bold mb-1">{{label}}</legend>
                {{#columns}}
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="local_quizbulkedit_col_{{field}}"
                           data-column="{{field}}"{{#checked}} checked{{/checked}}>
                    <label for="local_quizbulkedit_col_{{field}}" class="form-check-label">{{label}}</label>
                </div>
                {{/columns}}
            </fieldset>
            {{/groups}}
            <button type="button" class="btn btn-link btn-sm p-0" data-action="defaultcolumns">
                {{#str}} columnsdefault, local_quizbulkedit {{/str}}
            </button>
        </div>
    </div>
</div>
<form method="post" action="{{actionurl}}" id="local_quizbulkedit_form" data-region="local_quizbulkedit">
    <input type="hidden" name="id" value="{{courseid}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="filter" value="{{filter}}" data-region="filtervalue">

    <div class="card mb-3">
        <div class="card-body d-flex flex-wrap align-items-end gap-2">
            <div>
                <label for="local_quizbulkedit_field" class="form-label mb-1">{{#str}} field, local_quizbulkedit {{/str}}</label>
                <select id="local_quizbulkedit_field" class="form-select" data-action="bulkfield">
                    {{#fields}}
                        <option value="{{field}}"{{#colhidden}} hidden{{/colhidden}}>{{label}}</option>
                    {{/fields}}
                </select>
            </div>
            <div>
                <label class="form-label mb-1" data-region="bulkvaluelabel">{{#str}} value, local_quizbulkedit {{/str}}</label>
                {{#fields}}
                    {{#isselect}}
                    <select id="local_quizbulkedit_value_{{field}}" class="form-select" data-bulkvalue="{{field}}" hidden>
                        {{#options}}<option value="{{value}}">{{label}}</option>{{/options}}
                    </select>
                    {{/isselect}}
                    {{^isselect}}
                    <input type="{{type}}" id="local_quizbulkedit_value_{{field}}" class="form-control" data-bulkvalue="{{field}}"
                           {{#isnumber}}min="0" step="{{step}}"{{/isnumber}} aria-describedby="local_quizbulkedit_valuehelp" hidden>
                    {{/isselect}}
                {{/fields}}
            </div>
            <button type="button" class="btn btn-secondary" data-action="bulkapply">
                {{#str}} applytoselected, local_quizbulkedit {{/str}}
            </button>
            <button type="button" class="btn btn-outline-secondary" data-action="bulkrandom">
                {{#str}} randompasswords, local_quizbulkedit {{/str}}
            </button>
            <div id="local_quizbulkedit_valuehelp" class="form-text w-100 mt-0">
                {{#str}} clearvalue, local_quizbulkedit {{/str}}
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle generaltable local-quizbulkedit-table"
               data-reviewgrid="{{reviewgrid}}">
            <thead>
                <tr>
                    <th scope="col" class="local-quizbulkedit-sticky1">
                        <input type="checkbox" class="form-check-input" data-action="selectall" id="local_quizbulkedit_all">
                        <label for="local_quizbulkedit_all" class="visually-hidden">{{#str}} selectall, local_quizbulkedit {{/str}}</label>
                    </th>
                    <th scope="col" class="local-quizbulkedit-sticky2">{{#str}} quiz, local_quizbulkedit {{/str}}</th>
                    {{#fields}}
                    <th scope="col" data-col="{{field}}"{{#colhidden}} hidden{{/colhidden}}>
                        {{label}}
                        {{#hint}}<div class="small fw-normal text-muted">{{.}}</div>{{/hint}}
                        {{#isreview}}
                        <button type="button" class="btn btn-link btn-sm p-0 fw-normal" data-action="togglereviewall">
                            {{#str}} showallreview, local_quizbulkedit {{/str}}
                        </button>
                        {{/isreview}}
                    </th>
                    {{/fields}}
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr data-quizid="{{quizid}}" data-search="{{name}} {{section}}">
                    <td class="local-quizbulkedit-sticky1">
                        <input type="checkbox" class="form-check-input" data-action="select" id="local_quizbulkedit_sel{{quizid}}">
                        <label for="local_quizbulkedit_sel{{quizid}}" class="visually-hidden">{{#str}} select, local_quizbulkedit, {{name}} {{/str}}</label>
                    </td>
                    <td class="local-quizbulkedit-sticky2">
                        <a href="{{url}}" class="{{#hidden}}text-muted{{/hidden}}">{{name}}</a>
                        <a href="{{editurl}}" class="ms-1" title="{{#str}} editsettings, local_quizbulkedit, {{name}} {{/str}}"
                           aria-label="{{#str}} editsettings, local_quizbulkedit, {{name}} {{/str}}">{{#pix}} i/settings, core {{/pix}}</a>
                        <div class="small text-muted">{{section}}</div>
                    </td>
                    {{#cells}}
                    <td class="{{#changed}}table-warning{{/changed}}" data-cell="{{field}}" data-col="{{field}}"{{#colhidden}} hidden{{/colhidden}}>
                        {{#isreview}}
                        {{#reviewinputs}}
                        <input type="hidden" name="o[{{quizid}}][{{field}}]" value="{{original}}">
                        <input type="hidden" name="q[{{quizid}}][{{field}}]" value="{{value}}"
                               data-field="{{field}}" data-original="{{original}}" data-review="1">
                        {{/reviewinputs}}
                        <div class="d-flex align-items-center gap-2">
                            <label for="local_quizbulkedit_{{quizid}}_copy" class="visually-hidden">{{copylabel}}</label>
                            <select id="local_quizbulkedit_{{quizid}}_copy" class="form-select form-select-sm w-auto"
                                    data-action="reviewcopy">
                                {{#copyoptions}}<option value="{{value}}">{{label}}</option>{{/copyoptions}}
                            </select>
                            <button type="button" class="btn btn-link btn-sm p-0" data-action="togglereview"
                                    aria-controls="local_quizbulkedit_review{{quizid}}"
                                    aria-expanded="{{#reviewopen}}true{{/reviewopen}}{{^reviewopen}}false{{/reviewopen}}"
                                    aria-label="{{#str}} showreviewfor, local_quizbulkedit, {{name}} {{/str}}">
                                {{#str}} showreview, local_quizbulkedit {{/str}}
                            </button>
                        </div>
                        {{#error}}<div class="text-danger small">{{.}}</div>{{/error}}
                        {{/isreview}}
                        {{^isreview}}
                        <input type="hidden" name="o[{{quizid}}][{{field}}]" value="{{original}}">
                        <label for="local_quizbulkedit_{{quizid}}_{{field}}" class="visually-hidden">{{label}}</label>
                        {{#isselect}}
                        <select name="q[{{quizid}}][{{field}}]" id="local_quizbulkedit_{{quizid}}_{{field}}"
                                class="form-select form-select-sm{{#error}} is-invalid{{/error}}"
                                data-field="{{field}}" data-original="{{original}}"
                                {{#disabled}}disabled{{/disabled}} {{#error}}aria-invalid="true"{{/error}}>
                            {{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/options}}
                        </select>
                        {{/isselect}}
                        {{^isselect}}
                        <input type="{{type}}" name="q[{{quizid}}][{{field}}]" value="{{value}}"
                               id="local_quizbulkedit_{{quizid}}_{{field}}"
                               class="form-control form-control-sm{{#error}} is-invalid{{/error}}"
                               data-field="{{field}}" data-original="{{original}}"
                               {{#isnumber}}min="0" step="{{step}}" style="width: 6em"{{/isnumber}}
                               {{#error}}aria-invalid="true"{{/error}}>
                        {{/isselect}}
                        {{#note}}<div class="small text-muted">{{.}}</div>{{/note}}
                        {{#error}}<div class="invalid-feedback">{{.}}</div>{{/error}}
                        {{/isreview}}
                    </td>
                    {{/cells}}
                </tr>
                <tr id="local_quizbulkedit_review{{quizid}}" data-reviewfor="{{quizid}}" data-unusedduring="{{unusedduring}}"
                    {{^reviewopen}}hidden{{/reviewopen}}>
                    <td></td>
                    {{! Filled in by JS when first shown, to keep big courses' pages light. }}
                    <td colspan="{{colspan}}" data-region="reviewdetail"></td>
                </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>

    <button type="submit" class="btn btn-primary">{{#str}} savechanges, local_quizbulkedit {{/str}}</button>
</form>
{{#js}}
    require(['local_quizbulkedit/editor'], function(editor) {
        editor.init('local_quizbulkedit_form');
    });
{{/js}}
{{/hasrows}}
